{
  "name": "lezer-carve",
  "version": "0.1.0",
  "description": "Incremental parser for the Carve markup language, producing Lezer syntax trees",
  "keywords": [
    "lezer",
    "parser",
    "carve",
    "markup"
  ],
  "author": "Bugo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragomano/lezer-carve.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts"
  ],
  "scripts": {
    "example": "npm --prefix example run dev --",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check . --error-on-warnings",
    "check:ci": "biome ci . --error-on-warnings",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@lezer/common": "^1.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@codemirror/buildhelper": "^1.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
