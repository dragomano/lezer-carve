root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Parser fixtures preserve significant whitespace, BOMs and line endings.
[test/{corpus,fixtures}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
